{
  "name": "fix-please-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Fix Please - Electronic Repair Service & Management System",
  "scripts": {
    "start:all": "bun -e \"await Promise.all([Bun.spawn(['bun','run','dev'],{cwd:'backend',stdio:['inherit','inherit','inherit']}).exited,Bun.spawn(['bun','run','dev','--','--open'],{cwd:'frontend',stdio:['inherit','inherit','inherit']}).exited])\"",
    "backup": "tar -a -c -f backup.zip --exclude=node_modules --exclude=.git --exclude=backup.zip *"
  }
}
