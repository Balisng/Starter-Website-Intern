{
  "name": "fix-please-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Fix Please - Electronic Repair Service & Management System",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start:all": "bun -e \"await Promise.all([Bun.spawn(['bun','run','dev'],{cwd:'backend',stdio:['inherit','inherit','inherit']}).exited,Bun.spawn(['bun','run','dev','--','--open'],{cwd:'frontend',stdio:['inherit','inherit','inherit']}).exited])\"",
    "backup": "tar -a -c -f backup.zip --exclude=node_modules --exclude=.git --exclude=backup.zip *"
  },
  "dependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
