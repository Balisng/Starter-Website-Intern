              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"cm_username\": \"คุณสมศรี ใจดี\",\n  \"cm_cel\": \"0812345678\",\n  \"cm_email\": \"somsri@gmail.com\",\n  \"cm_symptom\": \"เครื่องเปิดติดแล้วดับเองหลังจากใช้งานประมาณ 10 นาที\",\n  \"promo_code\": \"HALLOWEEN20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inbox",
              "host": ["{{baseUrl}}"],
              "path": ["inbox"]
            }
          }
        },
        {
          "name": "GET All Inbox Tickets (Staff)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inbox",
              "host": ["{{baseUrl}}"],
              "path": ["inbox"]
            }
          }
        },
        {
          "name": "PATCH Mark Ticket as Read (Staff)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inbox/1/read",
              "host": ["{{baseUrl}}"],
              "path": ["inbox", "1", "read"]
            }
          }
        },
