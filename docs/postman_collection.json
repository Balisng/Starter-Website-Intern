          }
        },
        {
          "name": "DELETE Service (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/999",
              "host": ["{{baseUrl}}"],
              "path": ["services", "999"]
            }
          }
        }
      ]
    },
    {
