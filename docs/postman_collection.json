              "raw": "{\n  \"cg_id\": 1,\n  \"name\": \"อัปเกรด SSD NVMe M.2\",\n  \"detail\": \"บริการเพิ่มความจุและความเร็วเครื่องคอมพิวเตอร์ด้วย SSD NVMe\",\n  \"price\": 900,\n  \"status\": true,\n  \"service_image\": \"https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?auto=format&fit=crop&w=800&q=80\"\n}"
