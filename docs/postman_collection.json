    {
      "name": "6. Dashboard Module",
      "item": [
        {
          "name": "GET Dashboard Stats (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard?period=all",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"],
              "query": [{ "key": "period", "value": "all" }]
            }
          }
