            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1850,\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/services/1",
              "host": ["{{baseUrl}}"],
              "path": ["services", "1"]
