# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String
# For Local: postgresql://postgres:postgres@localhost:5432/repair_service_db
# For Vercel/Production (Neon, Supabase, etc.): postgresql://user:password@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repair_service_db

# JWT & Cookie Secret Key (Required: Server will not start if omitted)
JWT_SECRET=repair_service_secret_key_2026_change_in_production

# Initial Seed Accounts (Used when running `bun run db:seed`)
SEED_ADMIN_USERNAME=Admin
SEED_ADMIN_PASSWORD=<replace-with-admin-password>
SEED_TECH_USERNAME=TechSomchai
SEED_TECH_PASSWORD=<replace-with-technician-password>
