# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String
# For Local: postgresql://postgres:postgres@localhost:5432/repair_service_db
# For Vercel/Production (Neon, Supabase, etc.): postgresql://user:password@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repair_service_db

# JWT & Cookie Secret Key
JWT_SECRET=repair_service_secret_key_2026_change_in_production
